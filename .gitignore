# Local agent runtime and approval checkpoints
.claude/
.checkpoints/
# Local codex review-channel bundle (canonical bundle file; 5 of 7 referenced
# components live in the user's episodic memory root, not this repo). The
# `.claude/hooks/lib/command-classifier.sh` hook reads bundles/*.md at
# runtime; git-ignoring keeps `git status` clean without breaking the hook.
bundles/

# Office application lock files
.~lock.*#

.venv/
archive/
results/agent_status.json
